<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🎙️ أذونات الميكروفون وسماعات الرأس لتسجيل التلاوة -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 🌐 أذونات الإنترنت لجلب التلاوات الصوتية والتفاسير -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 💾 أذونات التخزين -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- ⏰ أذونات الإشعارات والتنبيهات -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JannatAlrahman"
        tools:targetApi="31">

        <!-- الأنشطة الرئيسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuranActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/quran" />

        <activity
            android:name=".AthkarActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/athkar" />

        <activity
            android:name=".TreeActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:label="@string/tree" />

        <!-- الخدمات -->
        <service
            android:name=".services.NotificationService"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".services.AudioService"
            android:enabled="true"
            android:exported="false" />

        <!-- المسائل -->
        <receiver
            android:name=".receivers.AlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ContentProvider للبيانات -->
        <provider
            android:name=".providers.QuranProvider"
            android:authorities="com.jannat.alrahman.provider"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>